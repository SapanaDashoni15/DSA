#include<bits/stdc++.h>
using namespace std;

struct TreeNode {
    int val;
    TreeNode *left;
    TreeNode* right;

    TreeNode(int data) {
        val = data;
        left = right = nullptr;
    }
};

// insert in BST
TreeNode* insert(TreeNode* root, int data) {
    if(root == nullptr) return new TreeNode(data);

    if(data < root->val) root->left = insert(root->left, data);
    else root->right = insert(root->right, data);

    return root;
}

//find node in BST
TreeNode* find(TreeNode* root, int data) {
    if(root == nullptr || root->val == data) return root;

    if(data < root->val) return find(root->left, data);
    else return find(root->right, data);

}

//recursive function to find LCA
TreeNode* findLCA(TreeNode* root, int p, int q) {
    if(root == nullptr) return root;

    if(root-> val < p && root->val < q) return findLCA(root->right, p, q);
    else if(root->val > p && root->val > q) return findLCA(root->left, p, q);

    else return root;
}

int main() {

    TreeNode* root = nullptr;
    root = insert(root, 20);
    insert(root, 10);
    insert(root, 30);

    TreeNode* ans = findLCA(root, 10, 30);
    cout << ans->val << endl;

    return 0;
}
